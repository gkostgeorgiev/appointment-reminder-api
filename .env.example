# Copy to .env and fill in real values. See src/config/env.ts for full validation rules.

PORT=5000
NODE_ENV=development

# MongoDB connection string (must start with mongodb:// or mongodb+srv://)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/appointment-reminder

# Random string, at least 32 characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=12345678901234567890123456789012

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGIN=https://your-frontend.example.com

# Twilio (SMS reminders) — Account SID starts with "AC"
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890

# "true" to run the reminder cron worker on this instance, "false" otherwise
RUN_REMINDER_WORKER=true

# Resend (password reset emails) — API key starts with "re_"
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Appointment Reminder <noreply@yourdomain.com>"

# Base URL used to build password-reset links: ${FRONTEND_URL}/reset-password?token=...
FRONTEND_URL=http://localhost:3000

# Optional, dev-only: phone number used by GET /api/dev/test-sms
PERSONAL_NUMBER=+1234567890

SENTRY_DSN=https://xxxxxxxxxxxxxxxxxx.ingest.sentry.io/xxxxxxxx